# Discover files in the directories below; dotfile add enrolls explicit files.
/*
!/README.md
!/.gitignore
!/.gitattributes
!/.config/
/.config/*
!/.config/brew/
!/.config/.jira/
/.config/.jira/*
!/.config/.jira/.config.yml
!/.config/dotfiles/
!/.config/fish/
!/.config/git/
!/.config/kitty/
!/.config/nvim/
!/.config/starship.toml
!/.config/tmux/
/.claude/

# Machine identity, private inputs, and migration state stay local.
/.config/dotfiles/machine
/.config/dotfiles/*.key
/.config/dotfiles/.git-crypt.key.*
/.config/dotfiles/.machine.*
/.config/dotfiles/local.fish
/.config/dotfiles/backup-location
/.config/fish/fish_variables

# Generated files and local state.
.DS_Store
.git/
node_modules/
*.log
*.swp
*.swo
*.bak
*.tmp
.dotfile.*
.env
.env.*
!.env.example
/.config/brew/.Brewfile.*
/.config/kitty/last-session
/.config/nvim/.neoconf.json.local
/.config/fish/conf.d/fish_frozen_key_bindings.fish
/.config/fish/functions/ask.fish
/.config/nvim/LICENSE
